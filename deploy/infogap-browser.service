[Unit]
Description=Collect isolated public browser candidates for InfoGap review
After=network-online.target docker.service infogap-osh.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/infogap-osh/current
ExecStartPre=/bin/sh /opt/infogap-osh/current/deploy/browser-network.sh --apply
ExecStart=/usr/bin/python3 /opt/infogap-osh/current/scripts/browser-collect.py --db /var/lib/infogap-osh/infogap.sqlite --accounts /opt/infogap-osh/current/data/x-accounts.json
ReadWritePaths=/var/lib/infogap-osh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
MemoryMax=256M
TimeoutStartSec=45min
TimeoutStopSec=15s
KillMode=control-group
