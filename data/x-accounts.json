  "purpose": "X机构与项目账号候选白名单，不是帖子正确性背书或采集成功记录",
  "policy": {
    "default_kind": "browser",
    "source_visibility": "public",
    "candidate_status": "pending",
    "candidate_evidence": "unverified",
    "require_primary_evidence_link": true,
    "trust_blue_badge": false,
    "collect_replies": false,
    "collect_reposts": false,
    "collect_promoted_posts": false,
    "allow_paid_api": false,
    "allow_user_credentials": false,
    "on_login_wall": "login_required",
    "on_challenge": "blocked",
    "on_failure": "preserve_error_without_advancing_last_success",
    "reject_content": [
      "广告与赞助帖",
      "带货、优惠码、返佣链接",
      "付费套餐促销",
      "拉群与涨粉诱导",
      "没有一手证据链接的夸大结论",
      "仅转帖、截图或二手爆料"
    ],
    "notes": [
      "primary_domains是核验入口提示，必须按完整域名或子域边界匹配；域名在列不等于帖子可信。",
      "展开t.co链接后再核对最终URL，禁止私网、环回、凭证URL和非http(s)目的地址。",
      "同一论文、DOI或release多平台去重；不因来自机构账号就自动发布。"
    ]
  },
